{
  "permissions": {
    "deny": [
      "Edit(/repos/legacy/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/deny_legacy_writes.py\" --claude"
          }
        ]
      }
    ]
  }
}
